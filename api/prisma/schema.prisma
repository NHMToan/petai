generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum DeviceStatus {
  AVAILABLE
  CLAIMED
  DISABLED
}

enum PetMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum PetMemoryKind {
  PROFILE
  PREFERENCE
  RELATIONSHIP
  ROUTINE
  FACT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum OrderSource {
  WEB
  MOBILE
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  name              String
  imageUrl          String?
  imageKey          String?
  role              Role              @default(USER)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  devices           Device[]          @relation("ClaimedDevices")
  pets              Pet[]
  petConversations  PetConversation[]
  petMemories       PetMemory[]
  orders            Order[]
}

model Device {
  id             String       @id @default(cuid())
  name           String
  serialNumber   String       @unique
  productCode    String       @unique
  status         DeviceStatus @default(AVAILABLE)
  claimedAt      DateTime?
  claimedById    String?
  claimedBy      User?        @relation("ClaimedDevices", fields: [claimedById], references: [id])
  pets           Pet[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Voice {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  tone        String
  locale      String
  version     String
  isActive    Boolean  @default(true)
  pets        Pet[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pet {
  id                String            @id @default(cuid())
  name              String
  species           String
  breed             String?
  age               Int?
  notes             String?
  imageUrl          String?
  imageKey          String?
  userId            String?
  deviceId          String?
  voiceId           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  owner             User?             @relation(fields: [userId], references: [id])
  device            Device?           @relation(fields: [deviceId], references: [id])
  voice             Voice?            @relation(fields: [voiceId], references: [id])
  conversations     PetConversation[]
  memories          PetMemory[]
  promptProfile     PetPromptProfile?
}

model PetConversation {
  id            String       @id @default(cuid())
  petId         String
  userId        String
  title         String?
  summary       String       @default("")
  lastMessageAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  pet           Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      PetMessage[]

  @@unique([petId, userId])
  @@index([petId, userId, lastMessageAt])
}

model PetMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           PetMessageRole
  content        String
  model          String?
  metadata       Json?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime       @default(now())
  conversation   PetConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model PetMemory {
  id         String        @id @default(cuid())
  petId      String
  userId     String
  kind       PetMemoryKind
  content    String
  importance Int           @default(1)
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  pet        Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId, userId, importance])
}

model PetPromptProfile {
  petId         String   @id
  persona       String   @default("")
  speakingStyle String   @default("")
  boundaries    String   @default("")
  backstory     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pet           Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  tagline          String
  shortDescription String
  description      String
  longDescription  String
  price            Float
  heroImage        String
  imageKey         String?
  gallery          Json
  specs            Json
  category         String
  badge            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orderItems       OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  status         OrderStatus @default(PENDING)
  source         OrderSource @default(WEB)
  customerName   String
  customerEmail  String
  customerPhone  String?
  company        String?
  shippingLine1  String
  shippingLine2  String?
  city           String
  state          String?
  postalCode     String?
  country        String
  note           String?
  subtotal       Float
  total          Float
  currency       String      @default("USD")
  userId         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User?       @relation(fields: [userId], references: [id])
  items          OrderItem[]

  @@index([status, createdAt])
  @@index([customerEmail, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  productName   String
  productSlug   String?
  heroImage     String?
  quantity      Int
  unitPrice     Float
  lineTotal     Float
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([productId])
}
